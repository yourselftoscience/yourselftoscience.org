{
  "name": "yourselftoscience.org",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourselftoscience/yourselftoscience.org.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": "next dev",
    "dev:watch": "node scripts/watchUpdatePdf.js",
    "dev": "concurrently \"npm run update-badge-logo\" \"npm run dev:next\" \"npm run dev:watch\"",
    "prebuild": "npm run update-badge-logo && npm run update-wikidata-stats && npm run update-wikidata && npm run update-ror && npm run update-ontology && npm run update-sitemap && npm run update-csv && npm run update-json && npm run update-idmap && npm run update-markdown && npm run update-rdf && npm run update-void && npm run update-llms && npm run update-openapi && npm run update-datapackage || echo 'Prebuild scripts failed, continuing build'",
    "build": "next build",
    "postbuild": "node scripts/updatePdfPage.js || echo 'PDF generation failed, continuing deployment'",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "test": "node --test scripts/*.test.js",
    "lint": "next lint",
    "watch-pdf": "node scripts/watchUpdatePdf.js",
    "update-ontology": "node scripts/updateOntology.js",
    "update-sitemap": "node scripts/generateSitemap.js",
    "update-csv": "node scripts/generateResourceCSV.js",
    "update-json": "node scripts/generateResourceJSON.js",
    "update-idmap": "node scripts/generateIdToSlug.js",
    "update-markdown": "node scripts/generateMarkdown.js",
    "update-rdf": "node scripts/generateRDF.js",
    "update-wikidata": "node scripts/_generateWikidata.js",
    "update-wikidata-stats": "node scripts/fetchWikidataStats.js",
    "update-ror": "node scripts/fetchROR.js",
    "update-llms": "node scripts/generateLLMsTxt.js",
    "update-openapi": "node scripts/generateOpenApi.js",
    "update-datapackage": "node scripts/generateDataPackage.js",
    "update-void": "node scripts/generateVoid.js",
    "update-badge-logo": "node scripts/updateBadgeLogo.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@vercel/analytics": "^1.5.0",
    "country-list": "^2.4.1",
    "framer-motion": "^11.11.1",
    "next": "15.5.28",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-select": "^5.8.1",
    "resend": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "globstar": "^1.0.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tar": "^7.5.21",
    "typescript": "^5",
    "wrangler": "4.151.0",
    "@eslint/config-array": "^0.18.0",
    "@eslint/object-schema": "^2.1.4",
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@rollup/plugin-inject": "^5.0.5",
    "chokidar": "4.0.3",
    "debug": "^4.3.7",
    "glob": "^11.1.0",
    "node-fetch": "^3.0.0",
    "playwright": "^1.58.2",
    "puppeteer": "25.14.0",
    "rimraf": "^6.0.1",
    "uuid": "^11.1.1",
    "@opennextjs/cloudflare": "1.20.12"
  },
  "overrides": {
    "glob": "^11.1.0",
    "js-yaml": "^4.1.0",
    "cookie": "^0.7.0",
    "@babel/runtime": "^7.26.0",
    "undici": "^6.19.2",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
