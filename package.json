{
  "name": "yourselftoscience.org",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourselftoscience/yourselftoscience.org.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": "next dev",
    "dev:watch": "node scripts/watchUpdatePdf.js",
    "dev": "concurrently \"npm run update-badge-logo\" \"npm run dev:next\" \"npm run dev:watch\"",
    "prebuild": "npm run update-badge-logo && npm run prebuild:enrichment && npm run prebuild:generate",
    "prebuild:enrichment": "(npm run update-wikidata-stats || echo 'Optional Wikidata statistics refresh failed; using checked-in data') && (npm run update-wikidata || echo 'Optional Wikidata refresh failed; using checked-in data') && (npm run update-ror || echo 'Optional ROR refresh failed; using checked-in data')",
    "prebuild:generate": "npm run update-ontology && npm run update-sitemap && npm run update-csv && npm run update-json && npm run update-idmap && npm run update-markdown && npm run update-rdf && npm run update-void && npm run update-llms && npm run update-openapi && npm run extend-openapi && npm run update-datapackage && npm run validate-agent-artifacts",
    "build": "next build",
    "postbuild": "node scripts/updatePdfPage.js || echo 'PDF generation failed, continuing deployment'",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "test": "node --test",
    "lint": "next lint",
    "watch-pdf": "node scripts/watchUpdatePdf.js",
    "update-ontology": "node scripts/updateOntology.js",
    "update-sitemap": "node scripts/generateSitemap.js",
    "update-csv": "node scripts/generateResourceCSV.js",
    "update-json": "node scripts/generateResourceJSON.js",
    "update-idmap": "node scripts/generateIdToSlug.js",
    "update-markdown": "node scripts/generateMarkdown.js",
    "update-rdf": "node scripts/generateRDF.js",
    "update-wikidata": "node scripts/_generateWikidata.js",
    "update-wikidata-stats": "node scripts/fetchWikidataStats.js",
    "update-ror": "node scripts/fetchROR.js",
    "update-llms": "node scripts/generateLLMsTxt.js",
    "update-openapi": "node scripts/generateOpenApi.js",
    "extend-openapi": "node scripts/extendAgentOpenApi.js",
    "validate-agent-artifacts": "node scripts/validateAgentArtifacts.js",
    "update-datapackage": "node scripts/generateDataPackage.js",
    "update-void": "node scripts/generateVoid.js",
    "update-badge-logo": "node scripts/updateBadgeLogo.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@vercel/analytics": "^1.5.0",
    "country-list": "^2.4.1",
    "framer-motion": "^11.11.1",
    "next": "15.5.22",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0",
    "react-select": "^5.8.1",
    "resend": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.18.0",
    "@eslint/object-schema": "^2.1.4",
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.5.3",
    "concurrently": "^9.1.2",
    "debug": "^4.3.7",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.22",
    "glob": "^11.1.0",
    "globstar": "^1.0.0",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.2",
    "postcss": "^8.5.3",
    "puppeteer": "^24.15.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tar": "^7.4.3",
    "typescript": "^5",
    "uuid": "^11.0.0",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "glob": "^11.1.0",
    "js-yaml": "^4.1.0",
    "cookie": "^0.7.0",
    "@babel/runtime": "^7.26.0",
    "undici": "^6.19.2",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
